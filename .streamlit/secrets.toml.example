# Copy these values into .streamlit/secrets.toml for local use.
# In Streamlit Community Cloud, add them in the app's Settings > Secrets panel instead.
# This file contains only a placeholder and must never contain a real key in Git.
SARVAM_API_KEY = "sk_replace_with_your_real_key"

# Optional: choose a Sarvam chat model enabled for your account.
SARVAM_MODEL = "sarvam-105b"
